{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh .claude/graphify-start.sh", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          { "type": "command", "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || true", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          { "type": "command", "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || true", "timeout": 10 }
        ]
      }
    ]
  }
}
